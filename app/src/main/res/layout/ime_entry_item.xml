<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/cue_card_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/cue_space_3"
    android:paddingEnd="@dimen/cue_space_3">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:importantForAccessibility="no"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Aegis.ImageView.Circle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cue_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/issuer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="GitHub" />

            <ImageView
                android:id="@+id/favorite_indicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="@dimen/cue_space_1"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_star_24"
                android:visibility="gone"
                android:tint="?attr/colorFavorite"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/suggested"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cue_space_2"
                android:background="@drawable/cue_pill_background"
                android:includeFontPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="@string/ime_suggested"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            tools:text="someone@example.com" />
    </LinearLayout>

    <TextView
        android:id="@+id/code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cue_space_2"
        android:includeFontPadding="false"
        android:layoutDirection="ltr"
        android:textAppearance="@style/TextAppearance.Cue.Code.Inline"
        tools:text="123 456" />

    <FrameLayout
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="@dimen/cue_space_3">

        <com.beemdevelopment.aegis.ime.CountdownRingView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/hotp_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_outline_refresh_24"
            android:visibility="gone"
            android:tint="?attr/colorOnSurfaceVariant" />
    </FrameLayout>
</LinearLayout>
