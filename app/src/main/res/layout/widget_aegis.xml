<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="2dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_cue_logo_small" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/cue_display_extrabold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textStyle="bold"
            android:textColor="@color/widget_on_surface"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/widget_lock_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_outline_lock_24"
            android:tint="@color/widget_on_surface_variant"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- an ImageView, because RemoteViews can't inflate a plain View -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="6dp"
        android:alpha="0.7"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/cue_brand_rule" />

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/widget_message_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_message_background"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_cue_logo_small" />

        <TextView
            android:id="@+id/widget_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/cue_display_semibold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp"
            tools:text="@string/widget_locked" />
    </LinearLayout>
</LinearLayout>
