<?xml version="1.0" encoding="utf-8"?>
<!-- The brand gradient as a hairline, used under headers -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="@color/cue_brand_end"
        android:startColor="@color/cue_brand_start"
        android:type="linear" />
    <size android:height="2dp" />
    <corners android:radius="1dp" />
</shape>
