{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Cue design tokens. Defined once, rendered natively: Material 3 on Android, SwiftUI on iOS/macOS. Values are the source of truth; platform files are derived.",
  "brand": {
    "seed": {
      "$type": "color",
      "$value": "#4F46E5",
      "$description": "Indigo seed. Material scheme is generated from it with the Fidelity variant so primaryContainer equals the seed."
    },
    "gradient": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#4F46E5",
          "position": 0
        },
        {
          "color": "#8B5CF6",
          "position": 1
        }
      ],
      "$description": "Top-left to bottom-right. Icon and hero surfaces only, never on text."
    },
    "mark": {
      "$type": "string",
      "$value": "Q ring: a 22-unit radius ring with a gap at 15°–75° and a tail from (65,65) to (80,80) in a 108-unit viewport, white, stroke 8."
    }
  },
  "color": {
