    "semantic": {
      "code": {
        "$type": "color",
        "$value": {
          "light": "#5B4DE9",
          "dark": "{color.dark.primary}"
        },
        "$description": "One-time code digits. Light uses the brand seed, dark the Material primary."
      },
      "codeHidden": {
        "$type": "color",
        "$value": "{color.*.outlineVariant}",
        "$description": "Dots shown instead of a code."
      },
      "favorite": {
        "$type": "color",
        "$value": "#F9A825",
        "$description": "Favorite indicator bar, both modes."
      },
      "expiring": {
        "$type": "color",
        "$value": "{color.*.error}",
        "$description": "Countdown ring and code in the last 5 seconds of a period."
      },
      "success": {
        "$type": "color",
        "$value": {
          "light": "#518242",
          "dark": "#d9e7cb"
        }
      }
    },
    "widget": {
      "$description": "Home screen widget follows the system accent (Material You) on Android 12+, the light/dark roles above elsewhere."
    }
  },
  "radius": {
    "small": {
      "$type": "dimension",
      "$value": "8dp",
      "$description": "Chips, small controls."
    },
    "medium": {
      "$type": "dimension",
      "$value": "16dp",
      "$description": "Entry cards, widget rows, menus."
    },
    "large": {
      "$type": "dimension",
      "$value": "20dp",
      "$description": "Panels, the keyboard sheet."
    },
    "extraLarge": {
      "$type": "dimension",
      "$value": "28dp",
      "$description": "Dialogs, bottom sheets, widget background."
    },
    "icon": {
      "$type": "dimension",
      "$value": "50%",
      "$description": "Entry icons are circles."
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4dp"
    },
    "2": {
      "$type": "dimension",
      "$value": "8dp"
    },
    "3": {
      "$type": "dimension",
      "$value": "12dp"
    },
    "4": {
      "$type": "dimension",
      "$value": "16dp"
    },
    "6": {
      "$type": "dimension",
      "$value": "24dp"
    }
  },
  "type": {
    "family": {
      "$type": "string",
      "$value": {
        "android": "Roboto (sans-serif)",
        "apple": "SF Pro"
      },
      "$description": "System fonts; digits always with tabular figures (tnum)."
    },
    "code": {
      "display": {
        "$type": "typography",
        "$value": {
          "size": "34sp",
          "weight": 700,
          "tracking": "0.02em",
          "features": [
            "tnum"
          ]
        },
        "$description": "Main list, normal view mode."
      },
      "compact": {
        "$type": "typography",
        "$value": {
          "size": "26sp",
          "weight": 700,
          "tracking": "0.02em",
          "features": [
            "tnum"
          ]
        },
        "$description": "Compact, small and tile view modes."
      },
      "inline": {
        "$type": "typography",
        "$value": {
          "size": "20sp",
          "weight": 700,
          "tracking": "0.02em",
          "features": [
            "tnum"
          ]
        },
        "$description": "Keyboard rows, widget rows (18sp)."
      },
      "grouping": {
        "$type": "string",
        "$value": "Digits grouped per the user's setting (default threes); Steam and Yandex codes never grouped."
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "size": "16sp",
        "weight": 700
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "size": "14sp",
        "weight": 400
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "size": "12sp",
        "weight": 400
      }
    }
  },
  "size": {
    "entryIcon": {
      "$type": "dimension",
      "$value": {
        "list": "60dp",
        "compact": "40dp",
        "keyboard": "32dp",
        "widget": "30dp"
      }
    },
    "keyboardPanel": {
      "$type": "dimension",
      "$value": {
        "portrait": "300dp",
        "landscape": "210dp"
      }
    },
    "touchTarget": {
      "$type": "dimension",
      "$value": "48dp"
    }
  },
  "motion": {
    "countdown": {
      "$type": "string",
      "$value": "Ring drains clockwise from 12 o'clock, 2.5dp stroke, turns {color.semantic.expiring} with 5s left; code refreshes exactly on the period boundary."
    },
    "reveal": {
      "$type": "duration",
      "$value": "30s",
      "$description": "Tap-to-reveal and widget reveal length; follows the user's setting."
    }
  },
  "apple": {
    "$description": "How the same tokens render on iOS/macOS.",
    "materials": "Cards: .regularMaterial on .background; keyboard/panel: .thinMaterial; widget: system widget background.",
    "colors": "Define the light/dark roles as Color Set assets; primaryContainer stays the seed; dynamic tint = accentColor from the seed.",
    "type": "SF Pro with .monospacedDigit() for codes; sizes map 34/26/20sp to 34/26/20pt.",
    "shape": "RoundedRectangle(cornerRadius: radius.medium, style: .continuous) for cards."
  }
}